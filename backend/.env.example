APP_NAME=PreBite API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
MONGODB_URI=
MONGODB_DATABASE=prebite
MONGO_ALLOW_INVALID_CERT=false
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
CLAUDE_API_KEY=
# Set to a model available to your Anthropic account.
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: Google Images search (server-side only). No key uses Wikimedia.
SERPAPI_API_KEY=
